{
  "name": "diyo-in-the-dark",
  "version": "0.1.0",
  "private": true,
  "description": "A Tihar-themed first-person web game built with Three.js.",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild js/main.js --bundle --format=iife --minify --outfile=js/bundle.js",
    "watch": "esbuild js/main.js --bundle --format=iife --outfile=js/bundle.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.20.2"
  }
}
